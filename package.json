{
  "name": "room-haus",
  "description": "Virtual Imprints",
  "private": true,
  "version": "1.0.0",
  "author": "Nicholas Licitra <nicholas.licitra@gmail.com>",
  "dependencies": {
    "babylonjs": "4.2.2",
    "babylonjs-materials": "4.2.2",
    "babylonjs-procedural-textures": "4.2.2",
    "d3": "7.9.2",
    "hls.js": "1.7.4",
    "lodash": "4.18.1",
    "mux.js": "6.3.0",
    "prop-types": "15.8.1",
    "pts": "0.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --mode development",
    "watch": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "postbuild": "node scripts/build-routes.mjs",
    "serve": "node scripts/serve.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write src --ignore-unknown",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-react": "8.0.1",
    "@playwright/test": "1.65.1",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "prettier": "3.10.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/room-haus/room.haus"
  },
  "engines": {
    "node": "24.x"
  }
}
